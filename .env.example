# Copy to .env (gitignored) and fill in. Read automatically by `docker compose`.
QF_MCP_TOKEN=            # generate: openssl rand -hex 24
WORKSPACE=               # absolute path of the repo the agent edits
TF_PORT=8790             # host port for the TrueForge UI

# Convenience copy of your Groq key. NOTHING reads this variable: paste the key into the TrueForge UI
# (Settings -> Models) instead. Keep it blank if you would rather not store it on disk.
GROQ_API_KEY=
