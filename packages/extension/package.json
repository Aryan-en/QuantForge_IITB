{
  "name": "forge",
  "displayName": "QuantForge",
  "description": "Editor-native coding agent. The agent loop runs on TrueForge; every change is reviewed hunk by hunk before it touches disk.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "forge-dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "QuantForge is read-only in untrusted workspaces: it will not run commands or apply changes."
    }
  },
  "activationEvents": [
    "onView:forge.sidebar",
    "onCommand:forge.openAgent",
    "onCommand:forge.inlineEdit",
    "onCommand:forge.startTrueForge"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "QuantForge",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "type": "webview",
          "id": "forge.sidebar",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.inlineEdit",
        "title": "QuantForge: Inline Edit Selection",
        "category": "QuantForge"
      },
      {
        "command": "forge.openAgent",
        "title": "QuantForge: Open Agent",
        "category": "QuantForge"
      },
      {
        "command": "forge.newSession",
        "title": "QuantForge: New Session",
        "category": "QuantForge"
      },
      {
        "command": "forge.cancel",
        "title": "QuantForge: Stop",
        "category": "QuantForge"
      },
      {
        "command": "forge.startTrueForge",
        "title": "QuantForge: Start TrueForge (local mode)",
        "category": "QuantForge"
      },
      {
        "command": "forge.checkConnection",
        "title": "QuantForge: Check TrueForge Connection",
        "category": "QuantForge"
      },
      {
        "command": "forge.review.acceptAll",
        "title": "QuantForge: Accept All Changes",
        "category": "QuantForge"
      },
      {
        "command": "forge.review.rejectAll",
        "title": "QuantForge: Reject All Changes",
        "category": "QuantForge"
      },
      {
        "command": "forge.review.apply",
        "title": "QuantForge: Apply Accepted Changes",
        "category": "QuantForge"
      },
      {
        "command": "forge.review.undo",
        "title": "QuantForge: Undo Last Applied Batch",
        "category": "QuantForge"
      },
      {
        "command": "forge.hunk.accept",
        "title": "QuantForge: Accept Hunk"
      },
      {
        "command": "forge.hunk.reject",
        "title": "QuantForge: Reject Hunk"
      },
      {
        "command": "forge.openSettings",
        "title": "QuantForge: Open Settings",
        "category": "QuantForge"
      },
      {
        "command": "forge.resume",
        "title": "QuantForge: Resume Interrupted Task",
        "category": "QuantForge"
      }
    ],
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "forge.openAgent",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "forge.cancel",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "forge.running"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forge.inlineEdit",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "QuantForge",
      "properties": {
        "forge.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "URL of the local TrueForge server. Must be a loopback address."
        },
        "forge.model.primary": {
          "type": "string",
          "default": "",
          "description": "TrueForge model name (provider/model) used by the agent. Configure providers and API keys in TrueForge, never here."
        },
        "forge.model.fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ordered TrueForge model names to fall back to automatically when the primary fails."
        },
        "forge.context.budgetTokens": {
          "type": "number",
          "default": 24000,
          "minimum": 1000,
          "description": "Token budget for automatically assembled context."
        },
        "forge.context.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra glob patterns excluded from search and context."
        },
        "forge.stallTimeoutMs": {
          "type": "number",
          "default": 45000,
          "minimum": 5000,
          "description": "Treat the model as stalled after this long without any event. Default suits hosted models; for a LOCAL model on modest hardware (first token can take minutes) raise it to 300000\u2013600000 and start TrueForge with MODEL_HTTP_HEADERS_TIMEOUT_MS=300000."
        },
        "forge.review.autoOpenOnPause": {
          "type": "boolean",
          "default": true,
          "description": "Open the review automatically when the agent asks to submit changes."
        },
        "forge.agent.shadowWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Run agent commands in a disposable copy that includes proposed edits, never in your working tree."
        },
        "forge.agent.pythonBin": {
          "type": "string",
          "default": "",
          "description": "Directory prepended to PATH for agent commands (e.g. a virtualenv's bin). A .venv/venv in the workspace is detected automatically."
        },
        "forge.index.persistent": {
          "type": "boolean",
          "default": true,
          "description": "Keep a persistent SQLite (FTS5) symbol index in extension storage for fast startup and @symbol search. Falls back to on-demand parsing if unavailable."
        }
      }
    }
  },
  "dependencies": {
    "@forge/protocol": "*",
    "@forge/context-engine": "*",
    "@forge/diff-engine": "*",
    "@forge/editor-mcp": "*",
    "@forge/trueforge-client": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/REPLACE-WITH-OWNER/QuantForge_IITB"
  }
}
